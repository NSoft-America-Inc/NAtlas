#!/bin/bash
cd "$(dirname "$0")"

# 1. 터미널 타이틀 설정 및 웅장한 로고 출력
echo -e "\033]0;NAtlas Presentation Launcher\007"
clear
echo -e "\033[1;36m========================================================\033[0m"
echo -e "\033[1;36m      NStack ➔ NAtlas E2E 지식 파이프라인 컨트롤러      \033[0m"
echo -e "\033[1;36m========================================================\033[0m"
echo -e "\033[1;32m[시스템] 로컬 백엔드 웹서버(파이썬 8080) 가동 중...\033[0m"

# 2. 파이썬 웹서버 백그라운드 기동 (포트 8080)
python3 -m http.server --directory docs/presentation 8080 &
SERVER_PID=$!

# 3. 안전한 서버 로딩 대기 및 기본 브라우저 자동 오픈 워프
sleep 0.5
echo -e "\033[1;34m[시스템] 기본 웹 브라우저를 자동 실행하여 대시보드로 워프합니다...\033[0m"
open "http://localhost:8080/presentation_index.html"

echo -e "\033[1;32m[완료] 프레젠테이션이 성공적으로 켜졌습니다!\033[0m"
echo -e "💡 발표를 모두 마치신 뒤, 이 터미널 창을 닫으시면 백그라운드 서버가 자동으로 안전하게 종료됩니다."
echo -e "\033[1;36m========================================================\033[0m"

# 4. 터미널 창 종료 시 백그라운드 파이썬 프로세스 자동 킬(Kill) 트리거 등록
trap "kill $SERVER_PID 2>/dev/null" EXIT
wait
